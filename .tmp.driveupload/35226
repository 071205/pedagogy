import { chromium } from "playwright";
import { spawn } from "node:child_process";
const srv=spawn("python3",["serve.py","--port","8791"],{stdio:"ignore"});
await new Promise(r=>setTimeout(r,1500));
const b=await chromium.launch(); const page=await b.newPage();
await page.goto("http://127.0.0.1:8791/",{waitUntil:"domcontentloaded"});
await page.evaluate(()=>localStorage.setItem("PM_SETS_V7:guest",JSON.stringify(
  ["가 세트","나 세트"].map((n,i)=>({id:"s"+i,name:n,header:"",problems:[{id:"q"+i,title:"",desc:"",
    answer:"",answerImg:"",numLabel:"",paired:false,blocks:[{type:"statement",data:{text:"x"}}]}]})))));
await page.goto("http://127.0.0.1:8791/?t="+Date.now(),{waitUntil:"networkidle"});
await page.waitForFunction(()=>document.querySelectorAll("#setGrid .set-card").length>=2,{timeout:15000});
await page.evaluate(()=>{
  const q=s=>document.querySelector(s), all=s=>[...document.querySelectorAll(s)];
  window.prompt=()=>"모의고사";
  all(".folder-chip").find(c=>/New folder|새 폴더/.test(c.textContent)).click();
  q("#selectBtn").click(); all("#setGrid .set-card .pick")[0].click();
  window.prompt=()=>"1"; q("#selMoveBtn").click(); q("#selectBtn").click();
});
await page.waitForTimeout(400);           // 로컬 저장 디바운스(150ms) 이후
const after = await page.evaluate(()=>JSON.parse(localStorage.getItem("PM_SETS_V7:guest")||"[]")
  .map(s=>({name:s.name, folderId:s.folderId===undefined?"(없음)":s.folderId})));
console.log("디바운스 뒤 :", JSON.stringify(after));
// 새로고침해도 살아 있는가 = 진짜 저장됐는가
await page.goto("http://127.0.0.1:8791/?t="+Date.now(),{waitUntil:"networkidle"});
await page.waitForFunction(()=>document.querySelectorAll(".folder-chip").length>2,{timeout:15000});
console.log("새로고침 뒤 칩:", JSON.stringify(await page.evaluate(()=>
  [...document.querySelectorAll(".folder-chip")].map(c=>c.textContent))));
await b.close(); srv.kill();
