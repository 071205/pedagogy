import { chromium } from "playwright";
import { spawn } from "node:child_process";
import { writeFileSync } from "node:fs";
const OUT = process.argv[2];
const srv = spawn("python3", ["serve.py", "--port", "8792"], { stdio: "ignore" });
await new Promise(r => setTimeout(r, 1500));
const b = await chromium.launch(); const page = await b.newPage();
const errs = []; page.on("pageerror", e => errs.push(String(e.message)));
await page.goto("http://127.0.0.1:8792/mock-exam-editor.html?t=" + Date.now(), { waitUntil: "networkidle" });
await page.waitForFunction(() => window.PedagogyExam && window.PedagogyExamTemplate && typeof window.toHwpx === "function", { timeout: 20000 });
// 서버 경로를 **막아** 브라우저 경로만 남긴다 — 어느 쪽이 만들었는지 확실히 가른다
const dl = page.waitForEvent("download", { timeout: 30000 });
const r = await page.evaluate(async () => {
  const realFetch = window.fetch;
  let serverHit = false;
  window.fetch = (u, o) => {
    if (String(u).includes("/hwpx")) { serverHit = true; return Promise.reject(new Error("서버 경로 막음")); }
    return realFetch(u, o);
  };
  await window.toHwpx();
  window.fetch = realFetch;
  return { serverHit };
});
const d = await dl;
await d.saveAs(OUT);
console.log("서버 경로를 탔나:", r.serverHit ? "예(=브라우저 실패)" : "아니오 ✅ 브라우저가 만들었다");
console.log("받은 파일:", OUT);
console.log("errs:", errs.slice(0, 3));
await b.close(); srv.kill();
