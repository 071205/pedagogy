rules_version = '2';

// PEDAGOGY — Firestore 보안 규칙
//
// 저장 구조 (index.html 의 loadSets() / saveSets() / flushToCloud())
//
//   users/{uid}                → { migratedAt }  · 예전 { sets:[...] } 문서도 남아 있음
//   users/{uid}/sets/{setId}   → { id, name, header, problems:[...], order,
//                                  deleted, updatedAt }
//
// 예전에는 문제집 전체를 users/{uid} 문서 하나에 배열로 넣었다. 1MB 한도에
// 걸리고, 다른 탭이 같은 순간에 저장하면 통째로 덮어써졌다. 지금은 문제집
// 하나가 문서 하나다. 구버전 문서는 이관 뒤에도 지우지 않으므로(안전망)
// 읽기 권한은 그대로 열어 둔다.
//
// 핵심: 로그인 여부만 보는 게 아니라 "본인 uid 인지"까지 확인해야 한다.
// `allow read, write: if request.auth != null` 로 두면 로그인한 아무나
// 다른 사람의 데이터를 읽어갈 수 있다.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // 읽기: 본인 문서만
      allow read: if isOwner();

      // 쓰기: 본인 문서만.
      // 구버전 경로(sets 배열 통째 저장)와 새 경로(migratedAt 표식)를 모두 허용한다.
      // 나중에 최상위 필드를 추가하면 아래 목록에도 같이 넣어야 한다.
      // (넣지 않으면 저장이 '권한 오류' 로 실패한다)
      //
      // ⚠️ create, update 만 걸고 delete 는 따로 둔다. 예전에는 `allow write` 하나로
      // 묶여 있었는데, write 는 delete 까지 포함하는 반면 삭제 요청에는
      // request.resource 가 null 이라 아래 hasOnly(...) 가 평가되지 못하고 거부된다.
      // 그래서 계정 삭제가 이 문서 하나를 못 지우고 남겼다.
      allow create, update: if isOwner()
                            && request.resource.data.keys()
                                 .hasOnly(['sets', 'updatedAt', 'migratedAt']);

      // 계정 삭제 시 이 문서도 함께 지운다(본인 것만).
      allow delete: if isOwner();

      // ── 문제집 문서 ──
      match /sets/{setId} {
        allow read: if isOwner();

        // 문서 id 와 안에 적힌 id 가 어긋나면 병합 로직이 꼬이므로 함께 확인한다.
        // problems 는 배열이어야 하고, 삭제 표식(tombstone)일 때는 빈 배열이 온다.
        allow create, update: if isOwner()
                              && request.resource.data.keys().hasOnly(
                                   ['id','name','header','problems','order',
                                    'deleted','updatedAt'])
                              && request.resource.data.id == setId
                              && request.resource.data.problems is list
                              && request.resource.data.deleted is bool
                              && request.resource.data.updatedAt is number;

        // 실제 삭제는 쓰지 않는다(tombstone 으로 대체). 그래도 본인 것은 지울 수 있게 둔다.
        allow delete: if isOwner();
      }

      // 참고: Firestore 규칙은 OR 로 합쳐진다 — 여러 match 가 걸리면 그중
      // 하나라도 허용하면 허용이다. 따라서 여기에 `if false` 인 포괄 match 를
      // 두어도 위 sets 규칙을 취소하지 못하고, 의도만 흐려진다. 그래서 두지 않는다.
      // sets 외의 하위 컬렉션은 규칙이 없으므로 기본값(거부)이 적용된다.
    }

    // 그 밖의 모든 경로는 차단.
    // (규칙이 없으면 어차피 기본이 거부지만, 의도를 명시해 둔다)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
