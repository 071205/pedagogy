rules_version = '2';

// PEDAGOGY — Firestore 보안 규칙
//
// 저장 구조 (index.html 의 loadSets() / saveSets() / flushToCloud())
//
//   users/{uid}                → { migratedAt }  · 예전 { sets:[...] } 문서도 남아 있음
//   users/{uid}/sets/{setId}   → { id, name, header, problems:[...], order,
//                                  deleted, updatedAt }
//
// 예전에는 문제집 전체를 users/{uid} 문서 하나에 배열로 넣었다. 1MB 한도에
// 걸리고, 다른 탭이 같은 순간에 저장하면 통째로 덮어써졌다. 지금은 문제집
// 하나가 문서 하나다. 구버전 문서는 이관 뒤에도 지우지 않으므로(안전망)
// 읽기 권한은 그대로 열어 둔다.
//
// 핵심: 로그인 여부만 보는 게 아니라 "본인 uid 인지"까지 확인해야 한다.
// `allow read, write: if request.auth != null` 로 두면 로그인한 아무나
// 다른 사람의 데이터를 읽어갈 수 있다.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // 읽기: 본인 문서만
      allow read: if isOwner();

      // 구형 sets 배열은 읽기 전용 안전망이다. 새 클라이언트는 문제집을 하위 문서로
      // 이관한 뒤 migratedAt만 찍는다. 여기서 sets 배열 쓰기를 계속 허용하면 로그인한
      // 사용자가 1MB짜리 문서를 무제한 갱신해 비용·인덱스를 소모할 수 있다.
      allow create: if isOwner()
                    && request.resource.data.keys().hasOnly(['migratedAt'])
                    && request.resource.data.migratedAt is number;
      allow update: if isOwner()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['migratedAt'])
                    && request.resource.data.migratedAt is number;

      // 계정 삭제 시 이 문서도 함께 지운다(본인 것만).
      allow delete: if isOwner();

      // ── 문제집 문서 ──
      match /sets/{setId} {
        allow read: if isOwner();

        // Rules도 스키마다. 본문 안쪽까지 완전한 문법 검증은 앱의 normalize가 맡되,
        // 여기서는 비용·저장소 악용을 막을 수 있는 타입·길이·개수 상한을 강제한다.
        function hasSetShape() {
          return request.resource.data.keys().hasOnly(
                   ['id','name','header','problems','order',
                    'deleted','updatedAt','lineColor','subject'])
              && request.resource.data.id == setId
              && request.resource.data.name is string
              && request.resource.data.name.size() <= 160
              && request.resource.data.header is string
              && request.resource.data.header.size() <= 2000
              && request.resource.data.problems is list
              // N제 등 실제 문제집은 500문항을 넘을 수 있다. 앱의 클라우드 상한과
              // 같은 20,000으로 두되, Firestore의 1MiB 문서 한도도 별도로 적용된다.
              && request.resource.data.problems.size() <= 20000
              && request.resource.data.order is number
              && request.resource.data.order >= 0
              && request.resource.data.order <= 10000
              && request.resource.data.deleted is bool
              && request.resource.data.updatedAt is number
              && request.resource.data.lineColor is string
              && request.resource.data.lineColor.size() <= 16
              && request.resource.data.subject is string
              && request.resource.data.subject.size() <= 80;
        }

        function isTombstone() {
          return request.resource.data.deleted == true
              && request.resource.data.name == ''
              && request.resource.data.header == ''
              && request.resource.data.problems.size() == 0;
        }

        // 문서 id와 내부 id가 어긋나면 병합이 꼬인다. tombstone은 빈 내용만 허용한다.
        allow create, update: if isOwner()
                              && hasSetShape()
                              && (!request.resource.data.deleted || isTombstone());

        // 실제 삭제는 쓰지 않는다(tombstone 으로 대체). 그래도 본인 것은 지울 수 있게 둔다.
        allow delete: if isOwner();
      }

      // 참고: Firestore 규칙은 OR 로 합쳐진다 — 여러 match 가 걸리면 그중
      // 하나라도 허용하면 허용이다. 따라서 여기에 `if false` 인 포괄 match 를
      // 두어도 위 sets 규칙을 취소하지 못하고, 의도만 흐려진다. 그래서 두지 않는다.
      // sets 외의 하위 컬렉션은 규칙이 없으므로 기본값(거부)이 적용된다.
    }

    // 그 밖의 모든 경로는 차단.
    // (규칙이 없으면 어차피 기본이 거부지만, 의도를 명시해 둔다)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
