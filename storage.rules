rules_version = '2';

// PEDAGOGY — Cloud Storage 보안 규칙
//
// 이 앱이 Storage 에 쓰는 것은 문항 이미지뿐이다.
//   users/{uid}/images/{파일명}
//   (index.html 의 uploadBlobToStorage() — 1800px 이하 JPEG 로 줄여서 올린다)
//
// 참고: 화면에 이미지를 띄울 때는 getDownloadURL() 이 준 주소(?token=... 포함)를
// <img src> 에 그대로 넣는다. 이 토큰이 붙은 주소는 규칙과 무관하게 열리므로,
// 아래처럼 read 를 본인으로 제한해도 이미지는 정상적으로 보인다.
// (제한이 걸리는 쪽은 SDK 로 직접 목록을 훑거나 남의 파일을 읽으려는 접근이다)

service firebase.storage {
  match /b/{bucket}/o {

    match /users/{uid}/images/{allPaths=**} {
      // 읽기: 본인 파일만
      allow read: if request.auth != null
                  && request.auth.uid == uid;

      // 올리기/덮어쓰기: 본인 폴더에만, 이미지 파일만, 5MB 이하
      //
      // 이 규칙이 용량 폭탄에 대한 '최종' 방어선이다. 클라이언트도 같은 5MB 로
      // 막지만(index.html 의 MAX_UPLOAD_BYTES), 그건 헛되이 올렸다가 거절당하지
      // 않게 하는 편의일 뿐 방어가 아니다 — 개발자 도구로 얼마든지 우회된다.
      // ⚠️ 이 숫자를 바꾸면 index.html 의 MAX_UPLOAD_BYTES 도 함께 바꿀 것.
      //
      // 참고: 편집기는 업로드 전에 canvas 로 1800px JPEG 로 줄이므로 정상 사진은
      // 보통 1MB 를 넘지 않는다. 5MB 에 걸린다면 비정상적인 파일이다.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // 지우기: 본인 파일만
      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }

    // 그 밖의 모든 경로는 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
